#version 430

layout(local_size_x = 16, local_size_y = 16) in;
layout(std430, binding = 0) buffer ScalarField
{
    float field[];
};

uniform int width;
uniform int height;

void main()
{
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if ((p.x >= width + 2) || (p.y >= height + 2)) return;
    if ((p.x > 0) && (p.x < width + 1) && (p.y > 0) && (p.y < height + 1)) return;

    ivec2 nearest = clamp(p, ivec2(1), ivec2(width, height));
    field[p.y*(width + 2) + p.x] = field[nearest.y*(width + 2) + nearest.x];
}
