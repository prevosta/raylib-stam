#version 430

layout(local_size_x = 16, local_size_y = 16) in;
layout(std430, binding = 0) buffer VelocityField
{
    vec2 velocity[];
};

uniform int width;
uniform int height;
uniform vec2 sourcePosition;
uniform vec2 sourceVelocity;
uniform float sourceRadius;

void main()
{
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if ((p.x < 1) || (p.x > width) || (p.y < 1) || (p.y > height)) return;

    vec2 offset = vec2(p - ivec2(1)) - sourcePosition;
    float radiusSquared = sourceRadius*sourceRadius;
    float distanceSquared = dot(offset, offset);
    if (distanceSquared > 9.0*radiusSquared) return;

    float weight = exp(-distanceSquared/(0.5*radiusSquared));
    int index = p.y*(width + 2) + p.x;
    velocity[index] += sourceVelocity*weight;
}
