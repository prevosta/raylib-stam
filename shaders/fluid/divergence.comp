#version 430

layout(local_size_x = 16, local_size_y = 16) in;
layout(std430, binding = 0) readonly buffer VelocityField
{
    vec2 velocity[];
};
layout(std430, binding = 1) writeonly buffer DivergenceField
{
    float divergence[];
};

uniform int width;
uniform int height;

void main()
{
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if ((p.x >= width + 2) || (p.y >= height + 2)) return;

    int index = p.y*(width + 2) + p.x;
    if ((p.x == 0) || (p.x == width + 1) || (p.y == 0) || (p.y == height + 1))
    {
        divergence[index] = 0.0;
        return;
    }

    divergence[index] = 0.5*(velocity[index + 1].x - velocity[index - 1].x +
                              velocity[index + width + 2].y - velocity[index - width - 2].y);
}
