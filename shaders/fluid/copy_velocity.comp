#version 430

layout(local_size_x = 16, local_size_y = 16) in;
layout(std430, binding = 0) readonly buffer SourceField
{
    vec2 source[];
};
layout(std430, binding = 1) writeonly buffer DestinationField
{
    vec2 destination[];
};

uniform int width;
uniform int height;

void main()
{
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if ((p.x >= width + 2) || (p.y >= height + 2)) return;
    int index = p.y*(width + 2) + p.x;
    destination[index] = source[index];
}
