#version 430

layout(local_size_x = 16, local_size_y = 16) in;
layout(std430, binding = 0) readonly buffer VelocitySource
{
    vec2 sourceVelocity[];
};
layout(std430, binding = 1) writeonly buffer VelocityDestination
{
    vec2 destinationVelocity[];
};

uniform int width;
uniform int height;
uniform float timeStep;

int cellIndex(ivec2 p)
{
    return p.y*(width + 2) + p.x;
}

vec2 sampleVelocity(vec2 position)
{
    vec2 bounded = clamp(position, vec2(1.0), vec2(float(width), float(height)));
    ivec2 low = ivec2(floor(bounded));
    ivec2 high = min(low + ivec2(1), ivec2(width, height));
    vec2 fraction = bounded - vec2(low);
    vec2 lower = mix(sourceVelocity[cellIndex(low)], sourceVelocity[cellIndex(ivec2(high.x, low.y))],
                     fraction.x);
    vec2 upper = mix(sourceVelocity[cellIndex(ivec2(low.x, high.y))], sourceVelocity[cellIndex(high)],
                     fraction.x);
    return mix(lower, upper, fraction.y);
}

void main()
{
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if ((p.x >= width + 2) || (p.y >= height + 2)) return;

    int index = cellIndex(p);
    bool ghostX = (p.x == 0) || (p.x == width + 1);
    bool ghostY = (p.y == 0) || (p.y == height + 1);
    if (ghostX || ghostY)
    {
        ivec2 nearest = clamp(p, ivec2(1), ivec2(width, height));
        vec2 value = sourceVelocity[cellIndex(nearest)];
        if (ghostX) value.x = -value.x;
        if (ghostY) value.y = -value.y;
        destinationVelocity[index] = value;
        return;
    }

    vec2 velocity = sourceVelocity[index];
    vec2 backtrace = vec2(p) - timeStep*velocity;
    destinationVelocity[index] = sampleVelocity(backtrace);
}
