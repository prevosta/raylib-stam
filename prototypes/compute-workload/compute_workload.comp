#version 430

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer InputField
{
    vec4 inputField[];
};

layout(std430, binding = 1) writeonly buffer OutputField
{
    vec4 outputField[];
};

layout(std430, binding = 2) readonly buffer Parameters
{
    int gridWidth;
    int mode;
};

void main()
{
    ivec2 cell = ivec2(gl_GlobalInvocationID.xy);
    if ((cell.x >= gridWidth) || (cell.y >= gridWidth)) return;

    int index = cell.y*gridWidth + cell.x;

    if (mode == 0)
    {
        int left = cell.y*gridWidth + max(cell.x - 1, 0);
        int right = cell.y*gridWidth + min(cell.x + 1, gridWidth - 1);
        int up = max(cell.y - 1, 0)*gridWidth + cell.x;
        int down = min(cell.y + 1, gridWidth - 1)*gridWidth + cell.x;

        vec4 center = inputField[index];
        float pressureLike = (4.0*center.x + inputField[left].x +
                              inputField[right].x + inputField[up].x +
                              inputField[down].x)/8.0;
        outputField[index] = vec4(pressureLike, center.yzw);
    }
    else
    {
        vec2 velocity = inputField[index].xy;
        vec2 position = vec2(cell) - 0.01*velocity*float(gridWidth);
        position = clamp(position, vec2(0.0), vec2(float(gridWidth - 1)));

        ivec2 lower = ivec2(floor(position));
        ivec2 upper = min(lower + ivec2(1), ivec2(gridWidth - 1));
        vec2 fraction = fract(position);

        int i00 = lower.y*gridWidth + lower.x;
        int i10 = lower.y*gridWidth + upper.x;
        int i01 = upper.y*gridWidth + lower.x;
        int i11 = upper.y*gridWidth + upper.x;

        vec4 row0 = mix(inputField[i00], inputField[i10], fraction.x);
        vec4 row1 = mix(inputField[i01], inputField[i11], fraction.x);
        outputField[index] = mix(row0, row1, fraction.y);
    }
}
